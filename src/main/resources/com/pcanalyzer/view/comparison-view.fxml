<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="comparisonRoot"
      fx:controller="com.pcanalyzer.ui.ComparisonController"
      spacing="8.0">
    <padding>
        <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
    </padding>

    <!-- Top Toolbar Controls -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 6px 10px; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 4px; -fx-background-radius: 4px;">
        <Label text="Benchmark Category:" style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="categoryComboBox" prefWidth="200.0"/>

        <Label text="Target Resolution:" style="-fx-font-weight: bold;" fx:id="resolutionLabel"/>
        <ComboBox fx:id="resolutionComboBox" prefWidth="150.0"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Button text="⟳ Refresh Charts" onAction="#handleRefresh" styleClass="btn-primary">
            <tooltip><Tooltip text="Recompute benchmark scores and price-to-performance metrics"/></tooltip>
        </Button>
    </HBox>

    <!-- Vertically Responsive SplitPane: Top Chart vs Bottom Analytics -->
    <SplitPane fx:id="verticalSplitPane" orientation="VERTICAL" dividerPositions="0.48" VBox.vgrow="ALWAYS">

        <!-- Top Chart: Primary Performance BarChart -->
        <TitledPane text="Hardware Benchmark Performance Comparison" collapsible="false" maxHeight="Infinity">
            <VBox spacing="4.0" style="-fx-padding: 6px;">
                <BarChart fx:id="mainBarChart" legendVisible="true" animated="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis fx:id="mainXAxis" label="Component"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="mainYAxis" label="Score / FPS" autoRanging="true"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </TitledPane>

        <!-- Bottom Responsive SplitPane: Price-to-Performance vs Head-to-Head -->
        <SplitPane fx:id="bottomSplitPane" dividerPositions="0.55">

            <!-- Bottom Left: Price-to-Performance Metric Chart -->
            <TitledPane text="Price-to-Performance Efficiency Metric" collapsible="false">
                <VBox spacing="4.0" style="-fx-padding: 6px;">
                    <BarChart fx:id="valueBarChart" legendVisible="false" animated="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis fx:id="valueXAxis" label="Component"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="valueYAxis" label="Points/$ or $/FPS" autoRanging="true"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </TitledPane>

            <!-- Bottom Right: Head-to-Head Specification Matrix -->
            <TitledPane text="Head-to-Head Comparison Matrix" collapsible="false" minWidth="320.0">
                <VBox spacing="8.0" style="-fx-padding: 8px;">
                    <HBox spacing="8.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Component A:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="compareComboA" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Component B:" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="compareComboB" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <!-- Responsive Comparison Grid inside ScrollPane -->
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <GridPane fx:id="comparisonGrid" hgap="4.0" vgap="3.0"/>
                    </ScrollPane>
                </VBox>
            </TitledPane>
        </SplitPane>
    </SplitPane>
</VBox>
