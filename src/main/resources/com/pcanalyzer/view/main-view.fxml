<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pcanalyzer.ui.MainController"
            prefHeight="760.0" prefWidth="1180.0">

    <!-- Header Bar -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-bar">
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="PC Hardware Benchmark &amp; Build Analyzer" styleClass="app-title"/>
                    <Label text="Real-time compatibility checking, benchmark comparisons, and pricing insights" styleClass="app-subtitle"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Label fx:id="connectionStatusLabel" text="● Database Connected" style="-fx-text-fill: #006400; -fx-font-weight: bold;"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- Main Navigation Tabs -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <!-- Tab 1: Browse Hardware -->
            <Tab text="Hardware Catalog">
                <fx:include fx:id="browseView" source="browse-view.fxml"/>
            </Tab>

            <!-- Tab 2: Build Configurator -->
            <Tab text="Build Configurator">
                <fx:include fx:id="buildPanelView" source="build-panel.fxml"/>
            </Tab>

            <!-- Tab 3: Comparison View Placeholder -->
            <Tab text="Performance Comparisons">
                <VBox alignment="CENTER" spacing="16.0" style="-fx-padding: 40px; -fx-background-color: #f0f0f0;">
                    <Label text="Hardware Comparison &amp; Benchmark Charts" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2b579a;"/>
                    <Label text="Grouped bar charts for FPS by Resolution (1080p, 1440p, 4K) and Price-to-Performance ($/FPS, Points/$) will be integrated in Phase 5."
                           style="-fx-font-size: 14px; -fx-text-fill: #333333; -fx-text-alignment: center; -fx-max-width: 600px;" wrapText="true"/>
                    <Button text="Switch to Hardware Catalog" onAction="#handleSwitchToCatalog" styleClass="btn-primary"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="status-bar">
            <Label fx:id="statusMessageLabel" text="System ready." styleClass="status-text" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="componentCountLabel" text="Components: 0" styleClass="status-text"/>
        </HBox>
    </bottom>

</BorderPane>
